# Copy to .env and fill in only what you use.
# The system runs fully offline with the deterministic extractive provider
# when no keys are set.

SELFRAG_LLM_PROVIDER=auto
SELFRAG_EMBEDDING_PROVIDER=auto
SELFRAG_VECTOR_STORE=numpy

# OpenAI (optional)
# Write paper ~10+ page IEEE drafts require OpenAI or Ollama (not extractive mode).
SELFRAG_OPENAI_API_KEY=
SELFRAG_OPENAI_MODEL=gpt-4o-mini
SELFRAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# SELFRAG_OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (optional — alternative for Write paper long drafts)
SELFRAG_OLLAMA_BASE_URL=http://localhost:11434
SELFRAG_OLLAMA_MODEL=llama3.1

# Sentence-Transformers (optional, if installed)
SELFRAG_SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Semantic Scholar (optional — higher rate limit)
SELFRAG_SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall (optional — identify your client; used to locate legal OA PDFs)
SELFRAG_UNPAYWALL_EMAIL=selfrag@localhost

# Evidence gate / loops
SELFRAG_EVIDENCE_THRESHOLD=0.55
SELFRAG_INITIAL_TOP_K=5
SELFRAG_MAX_TOP_K=12
SELFRAG_MAX_RETRIEVAL_ATTEMPTS=3
SELFRAG_MAX_CORRECTION_LOOPS=2

SELFRAG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SELFRAG_LOG_LEVEL=INFO

# Product UI requires signup/login. Pytest sets this false automatically.
SELFRAG_AUTH_REQUIRED=true
# SELFRAG_SESSION_TTL_SECONDS=604800

# Claim verification: NLI by default. Set true to keep the lexical/LLM-judge baseline.
# Unprefixed USE_LLM_JUDGE=false is also accepted if SELFRAG_USE_LLM_JUDGE is unset.
SELFRAG_USE_LLM_JUDGE=false
# SELFRAG_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
# SELFRAG_NLI_FALLBACK_MODEL=typeform/distilbert-base-uncased-mnli
# SELFRAG_NLI_ALLOW_DOWNLOAD=true
